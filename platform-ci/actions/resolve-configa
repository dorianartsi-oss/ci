name: Resolve build config
description: >
  Deep-merges org defaults, the service's build_config.json, the central quality
  gates, and any workflow_dispatch overrides into a single effective config, and
  emits a build matrix over projects[]. Replaces create_json_file.py and the sed
  placeholder-substitution step (secrets are now injected as env at point of use,
  never written into JSON on disk).

inputs:
  config_file:
    description: Path to the service's build_config.json
    required: true
  defaults_file:
    description: Path to org defaults. Blank = the copy shipped with this action.
    required: false
    default: ''
  gates_json:
    description: Compact JSON of resolved quality gates. Merged LAST so central gates win.
    required: false
    default: '{}'
  sonar_scan:
    description: "'true'/'false' to override scan.sonar_scan; blank to use the config"
    required: false
    default: ''
  xray_scan:
    description: "'true'/'false' to override scan.xray_scan; blank to use the config"
    required: false
    default: ''

outputs:
  matrix:
    description: '{"include":[...]} — one entry per element of projects[]'
    value: ${{ steps.merge.outputs.matrix }}
  config:
    description: The full effective config as compact JSON
    value: ${{ steps.merge.outputs.config }}
  cmdb_code:
    value: ${{ steps.merge.outputs.cmdb_code }}
    description: Resolved CMDB code
  sonar_scan:
    value: ${{ steps.merge.outputs.sonar_scan }}
    description: Effective SonarQube toggle
  xray_scan:
    value: ${{ steps.merge.outputs.xray_scan }}
    description: Effective Xray toggle
  notify_email:
    value: ${{ steps.merge.outputs.notify_email }}
    description: Effective email-notification toggle
  recipients:
    value: ${{ steps.merge.outputs.recipients }}
    description: Comma-separated notification recipients
  registry_host:
    value: ${{ steps.merge.outputs.registry_host }}
    description: Artifactory host
  docker_repo:
    value: ${{ steps.merge.outputs.docker_repo }}
    description: Artifactory Docker repository key
  maven_repo:
    value: ${{ steps.merge.outputs.maven_repo }}
    description: Artifactory Maven virtual repository key

runs:
  using: composite
  steps:
    - name: Merge config
      id: merge
      shell: bash
      env:
        CONFIG_FILE: ${{ inputs.config_file }}
        DEFAULTS_IN: ${{ inputs.defaults_file }}
        GATES_JSON: ${{ inputs.gates_json }}
        SONAR_OVERRIDE: ${{ inputs.sonar_scan }}
        XRAY_OVERRIDE: ${{ inputs.xray_scan }}
      run: |
        set -euo pipefail

        defaults="${DEFAULTS_IN:-}"
        if [[ -z "$defaults" ]]; then
          defaults="$GITHUB_ACTION_PATH/../../defaults/build_config.defaults.json"
        fi
        for f in "$defaults" "$CONFIG_FILE"; do
          [[ -f "$f" ]] || { echo "::error::Missing config file: $f"; exit 1; }
          jq empty "$f" || { echo "::error::$f is not valid JSON"; exit 1; }
        done

        gates_file=$(mktemp)
        printf '%s' "${GATES_JSON:-}" > "$gates_file"
        [[ -s "$gates_file" ]] || printf '{}' > "$gates_file"
        jq empty "$gates_file" || { echo "::error::gates_json is not valid JSON"; exit 1; }

        # Precedence, lowest to highest: org defaults -> service config -> central
        # gates. Gates land last on purpose: a team must not be able to lower a
        # threshold the platform set for it.
        merged=$(jq -s '.[0] * .[1] * .[2]' "$defaults" "$CONFIG_FILE" "$gates_file")

        # Apply project_defaults to every project, then drop the template key.
        merged=$(jq '
          (.project_defaults // {}) as $pd
          | .projects |= map($pd * .)
          | del(.project_defaults, ._comment)
        ' <<<"$merged")

        # workflow_dispatch overrides win over everything.
        if [[ -n "$SONAR_OVERRIDE" ]]; then
          merged=$(jq --argjson v "$SONAR_OVERRIDE" '.scan.sonar_scan = $v' <<<"$merged")
        fi
        if [[ -n "$XRAY_OVERRIDE" ]]; then
          merged=$(jq --argjson v "$XRAY_OVERRIDE" '.scan.xray_scan = $v' <<<"$merged")
        fi

        count=$(jq '.projects | length' <<<"$merged")
        if [[ "$count" -eq 0 ]]; then
          echo "::error::$CONFIG_FILE declares no projects[] entries"
          exit 1
        fi

        missing=$(jq -r '
          [ .projects[] | select((.name // "") == "" or (.docker_image_name // "") == "") | (.name // "<unnamed>") ]
          | join(", ")
        ' <<<"$merged")
        if [[ -n "$missing" ]]; then
          echo "::error::projects[] entries missing name or docker_image_name: $missing"
          exit 1
        fi

        matrix=$(jq -c '{include: [ .projects[] | {
          name, type, language, builder,
          jdk_version: (.jdk_version | tostring),
          use_buildkit, docker_image_name, dockerfile, docker_context,
          maven_args, smoke_test,
          smoke_test_seconds: (.smoke_test_seconds | tonumber)
        } ]}' <<<"$merged")

        {
          echo "matrix=$matrix"
          echo "config=$(jq -c . <<<"$merged")"
          echo "cmdb_code=$(jq -r '.cmdb_code' <<<"$merged")"
          echo "sonar_scan=$(jq -r '.scan.sonar_scan' <<<"$merged")"
          echo "xray_scan=$(jq -r '.scan.xray_scan' <<<"$merged")"
          echo "notify_email=$(jq -r '.notify.email' <<<"$merged")"
          echo "recipients=$(jq -r '(.notify.recipients // []) + [.owner_email // ""] | map(select(. != "")) | unique | join(",")' <<<"$merged")"
          echo "registry_host=$(jq -r '.registry.host' <<<"$merged")"
          echo "docker_repo=$(jq -r '.registry.docker_repo' <<<"$merged")"
          echo "maven_repo=$(jq -r '.registry.maven_repo' <<<"$merged")"
        } >> "$GITHUB_OUTPUT"

        echo "### Effective build config" >> "$GITHUB_STEP_SUMMARY"
        echo '```json' >> "$GITHUB_STEP_SUMMARY"
        jq . <<<"$merged" >> "$GITHUB_STEP_SUMMARY"
        echo '```' >> "$GITHUB_STEP_SUMMARY"

        rm -f "$gates_file"
