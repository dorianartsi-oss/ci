{
  "_comment": "Org-wide defaults. Deep-merged UNDER the service's build_config.json, so anything here is overridable per service. 'project_defaults' is applied to every element of projects[].",

  "cmdb_code": "unknown",
  "owner_email": "",
  "module_name": "",

  "registry": {
    "host": "artifactory.corporate.io",
    "docker_repo": "docker-local",
    "maven_repo": "maven-virtual-registry"
  },

  "scan": {
    "sonar_scan": true,
    "enable_quality_gate": true,
    "force_continue_on_scan_failure": false
  },

  "tests": {
    "fail_on_test_failure": true,
    "min_coverage": 0
  },

  "notify": {
    "email": true,
    "recipients": [],
    "github_pages": false
  },

  "port": {
    "enabled": false,
    "blueprint": "service"
  },

  "project_defaults": {
    "type": "docker",
    "language": "java",
    "builder": "maven",
    "path": ".",
    "jdk_version": "17",
    "use_buildkit": true,
    "dockerfile": "Dockerfile",
    "docker_context": ".",
    "maven_args": "-B clean install -DskipTests=false -e",
    "smoke_test": true,
    "smoke_test_seconds": 10,
    "configs_files_to_copy": []
  },

  "projects": []
}